{% block body %}
    <div>
        <div class="citation-form">

            <h1>Ajouter une citation</h1>

            {{ form_start(form, {
                'attr': {
                    'novalidate': 'novalidate'
                }
            }) }}
            {{ form_row(form.texte) }}
            {{ form_row(form.auteur) }}
            {{ form_row(form.source) }}
            {{ form_row(form.annee_citation) }}
            {{ form_row(form.contexte) }}
            {{ form_row(form.lieu) }}
            {{ form_row(form.type_citation) }}

            <div>
                <button type="submit">Enregistrer</button>
            </div>
            {{ form_end(form) }}

            <a href="{{ path('app_citations_list') }}">
                Retour à la liste des produits
            </a>
        </div>
    </div>
{% endblock %}
