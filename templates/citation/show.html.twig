<div class="citation-item">
    <h2>{{ citation.Auteur }}</h2>
    <p>{{ citation.Texte }}</p>
    <p>Prononcé ou écrit à {{ citation.Lieu }} en {{ citation.AnneeCitation }}</p>
    <p>Le contexte: {{ citation.Contexte }}</p>
    <p>type de citation: {{ citation.TypeCitation }}</p>
    <p>source: {{ citation.Source }}</p>
    <p>Ajouté le {{ citation.CreatedAt|date("m/d/Y") }}</p>
</div>
