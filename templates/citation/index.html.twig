{% extends 'base.html.twig' %}

{% block title %}Bibliothèque de citations{% endblock %}

{% block body %}
<style>
    .citation-list { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
</style>

<div class="citation-list">
    {% for citation in citations %}
        <div class="citation-item">
            <h2>{{ citation.Auteur }}</h2>
            <p>{{ citation.Texte }}</p>
            <p>{{ citation.AnneeCitation }}</p>
            <a href="{{ path('app_citations_show', { id : citation.id } ) }}">Voir plus d'informations</a>
        </div>
    {% endfor %}
{% endblock %}
